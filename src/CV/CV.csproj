<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Permitir la localization de toda la app -->
		<BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
		<!-- Nombres de assets estables (sin hash): evita 404 por caché al redeployar en GitHub Pages -->
		<WasmFingerprintAssets>false</WasmFingerprintAssets>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Blazorise" Version="2.4.3" />
		<PackageReference Include="Blazorise.Bootstrap" Version="2.4.3" />
		<PackageReference Include="Blazorise.Icons.FontAwesome" Version="2.4.3" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Localization" Version="11.0.0" />
		<PackageReference Include="SolarBlazorDocs.Browser" Version="10.0.0" />
	</ItemGroup>

</Project>
