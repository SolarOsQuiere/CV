@namespace CV
@using SolarBlazorDocs.Components
@using CV.Pages

@* Documento imprimible con el curriculum completo: todas las secciones en un unico documento.
   Se renderiza con SolarBlazorDocs (HtmlRenderer) y se imprime con SolarBlazorDocs.Browser. *@

<DocumentLayout Language="@Language">
    <HeadContent>
        <base href="@BaseUri" />
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/devicon@2.16.0/devicon.min.css" />
        <link rel="stylesheet" href="@(BaseUri)css/tokens.css" />
        <link rel="stylesheet" href="@(BaseUri)css/base.css" />
        <link rel="stylesheet" href="@(BaseUri)css/layout.css" />
        <link rel="stylesheet" href="@(BaseUri)css/buttons.css" />
        <link rel="stylesheet" href="@(BaseUri)css/cards.css" />
        <link rel="stylesheet" href="@(BaseUri)css/chips.css" />
        <link rel="stylesheet" href="@(BaseUri)CV.styles.css" />
        <link rel="stylesheet" href="@(BaseUri)css/document.css" />
    </HeadContent>
    <ChildContent>
        <Inicio />
        <Experiencia />
        <Education />
        <Cursos />
        <Tecnologias />
        <SobreMi />
    </ChildContent>
</DocumentLayout>
