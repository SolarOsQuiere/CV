@namespace CV
@using SolarBlazorDocs.Components
@using CV.Pages

@* Documento imprimible con el curriculum completo: todas las secciones en un unico documento.
   Se renderiza con SolarBlazorDocs (HtmlRenderer) y se imprime con SolarBlazorDocs.Browser. *@

<DocumentLayout Language="@Language">
    <HeadContent>
        <base href="@BaseUri" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
        <link rel="stylesheet" href="@(BaseUri)_content/Radzen.Blazor/css/standard-base.css" />
        <link rel="stylesheet" href="@(BaseUri)css/app.css" />
        <link rel="stylesheet" href="@(BaseUri)css/styles.css" />
        <style>
            body { background: #fff; }
            #sideNav, .navbar, .no-print { display: none !important; }
            .resume-section { padding: 1.2cm 1.4cm; page-break-inside: avoid; }
            .resume-section:not(:last-of-type) { border-bottom: 1px solid #eee; }
            .experience-card { break-inside: avoid; }
            img { max-width: 100%; }
        </style>
    </HeadContent>
    <ChildContent>
        <Inicio />
        <SobreMi />
        <Experiencia />
        <Education />
        <Cursos />
        <Tecnologias />
        <Proyectos />
    </ChildContent>
</DocumentLayout>

@code {
    /// <summary>URL base absoluta de la app (para resolver imagenes y CSS relativos).</summary>
    [Parameter] public string BaseUri { get; set; } = "/";

    /// <summary>Idioma del documento (atributo lang).</summary>
    [Parameter] public string Language { get; set; } = "es";
}
