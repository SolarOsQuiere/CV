@using CV.Shared.Resources;
@using CV.Shared.Services
@inject IStringLocalizer<ExperienceRes> L
@inject IStringLocalizer<CommonRes> Common

<!-- Experience-->
<section class="resume-section" id="experiencia">
    <div class="resume-section-content">
        <PageTitleCentered Title=@(@Common["nav_experiencia"]) />

        <div class="timeline">

            <TimelineItem SrcImagen="assets/img/logoHiberus.png"
                          AltImagen="Hiberus Tecnología"
                          Current="true"
                          Description=@CreateFromString($"<p>{L["gadGatViviendaDescripcion1"]}<p>{L["gadGatViviendaDescripcion2"]}<br>{L["gadGatViviendaDescripcion3"]}</p>")
                          Tiempo=@($"may. 2022 - {L["tl_actual"]} · {TotalYearsMonthsFormatted(PeriodosExperiencia.InicioActual, DateTime.Now)}")
                          Subtitulo=@L["programadorWebJuniorHiberusSubTitulo"]
                          Titulo=@L["programadorWebJuniorHiberusTitulo"] />

            <TimelineItem SrcImagen="assets/img/logoHiberus.png"
                          AltImagen="Hiberus Tecnología"
                          Description=@CreateFromString($"<p>{L["contratoPracticasHiberus1Descripcion"]}</p>")
                          Tiempo=@($"dic. 2021 - mar. 2022 · 4 {Common["meses"]}")
                          Subtitulo=@L["contratoPracticasHiberus1Subitulo"]
                          Titulo=@L["contratoPracticasHiberus1Titulo"] />

            <TimelineItem SrcImagen="assets/img/logoGnoss.png"
                          AltImagen="Gnoss Tecnología"
                          Description=@CreateFromString($"{L["contratoPracticasGnossDescripcion"]}")
                          Tiempo=@($"sept. 2021 - dic. 2021 · 4 {Common["meses"]}")
                          Subtitulo=@L["contratoPracticasGnossSubitulo"]
                          Titulo=@L["contratoPracticasGnossSubitulo"] />

            <TimelineItem SrcImagen="assets/img/logoHiberus.png"
                          AltImagen="Hiberus Tecnología"
                          Description=@CreateFromString($"{L["contratoPracticasHiberus2Descripcion"]}")
                          Tiempo=@($"jul. 2021 - sept. 2021 · 3 {Common["meses"]}")
                          Subtitulo=@L["contratoPracticasHiberus2Subitulo"]
                          Titulo=@L["contratoPracticasHiberus21Titulo"] />

        </div>

    </div>
</section>


@code {
    String TotalYearsMonthsFormatted(DateTime fechaInicio, DateTime fechaFin)
    {
        int totalMeses = ((fechaFin.Year - fechaInicio.Year) * 12) + fechaFin.Month - fechaInicio.Month;
        int anios = totalMeses / 12;
        int meses = totalMeses % 12;


        var formattedString = anios.ToString() + " ";

        if (anios == 1)
        {
            formattedString += Common["year"];
        } else
        {
            formattedString += Common["years"];
        }

        formattedString += " " + meses + " ";
        if (meses == 1)
        {
            formattedString += Common["mes"];
        } else
        {
            formattedString += Common["meses"];
        }


        return formattedString;
    }

    public RenderFragment CreateFromString(string content)
    {
        RenderFragment renderFragment = builder =>
        {
            builder.AddMarkupContent(0, content);
        };

        return renderFragment;
    }
}