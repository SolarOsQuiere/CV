@inject IStringLocalizer<CoursesRes> L

<section class="resume-section" id="cursos">
    <div class="resume-section-content">

        <PageTitleCentered Title=@(L["cursosCertificaciones"]) />

        @foreach (var grupo in _cursos.GroupBy(c => c.Anio))
        {
            <div class="course-year"><span>@grupo.Key</span></div>

            <div class="course-grid">
                @foreach (var c in grupo)
                {
                    <article class="course-card">
                        <img class="course-logo" src="@c.Logo" alt="@c.Alt" />
                        <div class="course-body">
                            <span class="edu-date">@c.Fecha</span>
                            <h3>@c.Titulo</h3>

                            @if (!string.IsNullOrWhiteSpace(c.Subtitulo))
                            {
                                <p class="course-sub">@c.Subtitulo</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(c.Credencial))
                            {
                                <p class="course-cred">@L["idCredencial"] <code>@c.Credencial</code></p>
                            }
                            @if (!string.IsNullOrWhiteSpace(c.Descripcion))
                            {
                                <div class="course-desc">@((MarkupString)c.Descripcion)</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(c.Url))
                            {
                                <a class="course-link" href="@c.Url" target="_blank" rel="noopener noreferrer">
                                    @L["cursos_verificar"] <i class="fas fa-external-link-alt"></i>
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>
        }

    </div>
</section>

