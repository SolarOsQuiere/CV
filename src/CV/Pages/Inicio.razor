<section class="resume-section hero" id="@SectionIds.Inicio">
    <div class="resume-section-content hero-grid">

        <div class="hero-text">
            <p class="hero-hello">@L["hero_hola"]</p>
            <h1>Héctor <span class="hero-accent">Solar Ruiz</span></h1>
            <p class="hero-eyebrow">@L["subtituloProfesional"]</p>

            <p class="hero-lead">@L["subtituloPersonal"]</p>
            <p>@L["descripcionPersonal1"]</p>
            <p>@L["descripcionPersonal2"]</p>
            <p class="hero-edu">@L["descripcionPersonal3"]</p>

            <ul class="chips" aria-label="Stack">
                @foreach (var tech in Stack)
                {
                    <li>@tech</li>
                }
            </ul>

            <dl class="hero-stats">
                <div><dt>@ExperienciaTotal</dt><dd>@L["hero_stat_exp"]</dd></div>
                <div><dt>ES · EN</dt><dd>@L["hero_stat_idiomas"]</dd></div>
                <div><dt>.NET</dt><dd>@L["hero_stat_stack"]</dd></div>
            </dl>

            @if (ShowActions)
            {
                <div class="hero-actions no-print">
                    <PrintCvButton CssClass="btn-cv btn-cv-primary" Label=@L["hero_pdf"] BusyLabel=@L["hero_generando"] />
                </div>
            }

            <div class="hero-contact">
                <p class="hero-contact-label">@L["hero_contacto"]</p>
                <ul class="hero-contact-list">
                    <li>
                        <a class="contact-chip" href="@ExternalLinks.Contact.MailTo">
                            <i class="far fa-envelope" aria-hidden="true"></i>
                            <span>@ExternalLinks.Contact.Email</span>
                        </a>
                    </li>
                    <li>
                        <a class="contact-chip contact-chip-icon" href="@ExternalLinks.Social.LinkedIn" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">
                            <i class="fab fa-linkedin-in" aria-hidden="true"></i>
                        </a>
                    </li>
                    <li>
                        <a class="contact-chip contact-chip-icon" href="@ExternalLinks.Social.GitHub" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
                            <i class="fab fa-github" aria-hidden="true"></i>
                        </a>
                    </li>
                    <li>
                        <a class="contact-chip contact-chip-icon" href="@ExternalLinks.Social.StackOverflow" target="_blank" rel="noopener noreferrer" aria-label="Stack Overflow" title="Stack Overflow">
                            <i class="fab fa-stack-overflow" aria-hidden="true"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="hero-photo">
            <div class="hero-photo-frame">
                <img src="@AssetPaths.Profile" alt="Héctor Solar Ruiz" />
            </div>
        </div>

    </div>
</section>
