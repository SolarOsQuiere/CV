@using CV.Shared.Resources;
@using Microsoft.Extensions.Localization
@using System.Globalization
@using CV.Shared.Services

@inject IStringLocalizer<HeroRes> L
@inject IStringLocalizer<CommonRes> Common

<section class="resume-section hero" id="inicio">
    <div class="resume-section-content hero-grid">

        <div class="hero-text">
            <p class="hero-hello">@L["hero_hola"]</p>
            <h1>Héctor <span class="hero-accent">Solar Ruiz</span></h1>
            <p class="hero-eyebrow">@L["subtituloProfesional"]</p>

            <p class="lead mb-3">@L["subtituloPersonal"]</p>
            <p>@L["descripcionPersonal1"]</p>
            <p>@L["descripcionPersonal2"]</p>
            <p class="hero-edu">@L["descripcionPersonal3"]</p>

            <ul class="hero-chips" aria-label="Stack">
                @foreach (var tech in Stack)
                {
                    <li>@tech</li>
                }
            </ul>

            <dl class="hero-stats">
                <div><dt>@ExperienciaTotal</dt><dd>@L["hero_stat_exp"]</dd></div>
                <div><dt>ES · EN</dt><dd>@L["hero_stat_idiomas"]</dd></div>
                <div><dt>.NET</dt><dd>@L["hero_stat_stack"]</dd></div>
            </dl>

            @if (ShowActions)
            {
                <div class="hero-actions no-print">
                    <PrintCvButton CssClass="btn-cv btn-cv-primary" Label=@L["hero_pdf"] BusyLabel=@L["hero_generando"] />
                    <a class="btn-cv" href="mailto:hectorsolar99@gmail.com">@L["hero_contacto"]</a>
                </div>
            }

            <p class="hero-mail"><a href="mailto:hectorsolar99@gmail.com">hectorsolar99@gmail.com</a></p>

            <div class="social-icons">
                <a class="social-icon" href="https://www.linkedin.com/in/hesolar/" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                <a class="social-icon" href="https://github.com/hesolar" aria-label="GitHub"><i class="fab fa-github"></i></a>
                <a class="social-icon" href="https://stackoverflow.com/users/16686166/hesolar?tab=profile" aria-label="Stack Overflow"><i class="fab fa-stack-overflow"></i></a>
            </div>
        </div>

        <div class="hero-photo">
            <div class="hero-photo-frame">
                <img src="assets/img/profile.jpg" alt="Héctor Solar Ruiz" />
            </div>
        </div>

    </div>
</section>

@code {
    /// <summary>Muestra los botones de accion (PDF / contacto). Desactivado en el documento imprimible.</summary>
    [Parameter] public bool ShowActions { get; set; }

    private static readonly string[] Stack = ["C#", ".NET", "Blazor", "SQL", "Docker", "Jenkins", "SonarQube"];

    /// <summary>Suma de todos los periodos de la seccion de experiencia, p. ej. "5 años 5 meses".</summary>
    private string ExperienciaTotal
    {
        get
        {
            var total = PeriodosExperiencia.TotalMeses(DateTime.Today);
            var anios = total / 12;
            var meses = total % 12;

            var texto = $"{anios} {Common[anios == 1 ? "year" : "years"]}";
            if (meses > 0)
            {
                texto += $" {meses} {Common[meses == 1 ? "mes" : "meses"]}";
            }
            return texto;
        }
    }
}
