@using CV.Shared.Resources;
@inject IStringLocalizer<TechnologiesRes> L
@inject IStringLocalizer<CommonRes> Common

<section class="resume-section" id="tecnologias">
    <div class="resume-section-content">

        <PageTitleCentered Title=@(@Common["nav_tecnologias"]) />

        <div class="tech-grid">
            @foreach (var cat in _categorias)
            {
                <article class="tech-group">
                    <header class="tech-group-head">
                        <span class="tech-group-icon"><i class="fas @cat.Icono"></i></span>
                        <h3>@cat.Titulo</h3>
                    </header>

                    <ul class="tech-tiles">
                        @foreach (var t in cat.Items)
                        {
                            <li>
                                <a href="@t.Url" target="_blank" rel="noopener noreferrer" title="@t.Nombre">
                                    <span class="tech-ico" aria-hidden="true">
                                        @foreach (var icono in t.Iconos)
                                        {
                                            <i class="@icono"></i>
                                        }
                                    </span>
                                    <span>@t.Nombre</span>
                                </a>
                            </li>
                        }
                    </ul>
                </article>
            }

            <article class="tech-group tech-wide">
                <header class="tech-group-head">
                    <span class="tech-group-icon"><i class="fas fa-tasks"></i></span>
                    <h3>@L["metodologias"]</h3>
                </header>

                <ul class="hero-chips tech-methods">
                    @foreach (var m in _metodologias)
                    {
                        <li>@m</li>
                    }
                </ul>
            </article>
        </div>

    </div>
</section>

@code {
    /// <summary>Tecnologia con sus iconos (clases de Devicon o Font Awesome).</summary>
    private record Tech(string Nombre, string[] Iconos, string Url);
    private record Categoria(string Titulo, string Icono, Tech[] Items);

    private static readonly string[] _metodologias = ["Agile", "Scrum", "DDD & Clean Architecture", "SOLID"];

    private List<Categoria> _categorias = [];

    protected override void OnInitialized()
    {
        _categorias =
        [
            new(L["lenguagesProgramacion"], "fa-code",
            [
                new("HTML · CSS · JS", ["devicon-html5-plain colored", "devicon-css3-plain colored", "devicon-javascript-plain colored"], "https://html.spec.whatwg.org/"),
                new("C#", ["devicon-csharp-plain colored"], "https://learn.microsoft.com/dotnet/csharp/"),
                new("SQL Server", ["devicon-microsoftsqlserver-plain colored"], "https://www.microsoft.com/sql-server")
            ]),
            new("Frameworks", "fa-cubes",
            [
                new(".NET Core", ["devicon-dotnetcore-plain colored"], "https://dotnet.microsoft.com/"),
                new(".NET Framework", ["devicon-dot-net-plain colored"], "https://dotnet.microsoft.com/"),
                new("Blazor", ["devicon-blazor-original colored"], "https://learn.microsoft.com/aspnet/core/blazor/"),
                new("MVC", ["fas fa-layer-group"], "https://learn.microsoft.com/aspnet/core/mvc/"),
                new("EF Core", ["fas fa-database"], "https://learn.microsoft.com/ef/"),
                new("Swagger", ["devicon-swagger-plain colored"], "https://swagger.io/")
            ]),
            new(L["svcs"], "fa-code-branch",
            [
                new("Git", ["devicon-git-plain colored"], "https://git-scm.com/"),
                new("GitHub", ["devicon-github-original"], "https://github.com/"),
                new("GitLab", ["devicon-gitlab-plain colored"], "https://gitlab.com/")
            ]),
            new("QA, CI / CD", "fa-sync-alt",
            [
                new("Jenkins", ["devicon-jenkins-plain colored"], "https://www.jenkins.io/"),
                new("Docker", ["devicon-docker-plain colored"], "https://www.docker.com/"),
                new("SonarQube", ["devicon-sonarqube-original colored"], "https://www.sonarsource.com/products/sonarqube/"),
                new("Podman", ["devicon-podman-plain colored"], "https://podman.io/")
            ])
        ];
    }
}
