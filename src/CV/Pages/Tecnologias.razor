@page "/CV/Tecnologias"
@page "/CV/Technologies"
@page "/Tecnologias"
@page "/Technologies"

@using CV.Shared.Resources;
@inject IStringLocalizer<AllResourcesRes> AllResourcesResolver

<section class="resume-section py-4">
    <div class="container">

        <!-- Título -->
        <h2 class="text-center text-primary mb-5">
            @AllResourcesResolver["navbar_tecnologias"]
        </h2>

        <div class="row g-4">

            <!-- Lenguajes -->
            <div class="col-12 col-md-6">
                <RadzenCard Variant="Variant.Outlined" Class="h-100 tech-card">
                    <h4 class="mb-3">
                        @AllResourcesResolver["lenguagesProgramacion"]
                    </h4>

                    <ul class="mb-3">
                        <li>HTML, CSS, Javascript, C#, SQL</li>
                    </ul>

                    <div class="d-flex flex-wrap gap-3">
                        <a href="https://html.spec.whatwg.org/" target="_blank">
                            <img class="tech-icon" src="assets/icons/htmlcssjs.jfif" alt="HTML CSS JS" />
                        </a>

                        <a href="https://learn.microsoft.com/dotnet/csharp/" target="_blank">
                            <img class="tech-icon" src="assets/icons/csharp.png" alt="C#" />
                        </a>

                        <a href="https://www.microsoft.com/sql-server" target="_blank">
                            <img class="tech-icon" src="assets/icons/sql.png" alt="SQL" />
                        </a>
                    </div>
                </RadzenCard>
            </div>

            <!-- Frameworks -->
            <div class="col-12 col-md-6">
                <RadzenCard Variant="Variant.Outlined" Class="h-100 tech-card">
                    <h4 class="mb-3">Frameworks</h4>

                    <ul class="mb-3">
                        <li>.NET Core, .NET Framework, Blazor, MVC, EF, Swagger</li>
                    </ul>

                    <div class="d-flex flex-wrap gap-3">
                        <a href="https://dotnet.microsoft.com/" target="_blank">
                            <img class="tech-icon" src="assets/icons/dotnet.png" />
                        </a>

                        <a href="https://dotnet.microsoft.com/" target="_blank">
                            <img class="tech-icon" src="assets/icons/dotnetframework.png" />
                        </a>

                        <a href="https://learn.microsoft.com/aspnet/core/blazor/" target="_blank">
                            <img class="tech-icon" src="assets/icons/blazor.png" />
                        </a>

                        <a href="https://learn.microsoft.com/aspnet/core/mvc/" target="_blank">
                            <img class="tech-icon" src="assets/icons/mvc.png" />
                        </a>

                        <a href="https://learn.microsoft.com/ef/" target="_blank">
                            <img class="tech-icon" src="assets/icons/efcore.png" />
                        </a>

                        <a href="https://swagger.io/" target="_blank">
                            <img class="tech-icon" src="assets/icons/swaggeropenapi.png" />
                        </a>
                    </div>
                </RadzenCard>
            </div>

            <!-- DevOps / Herramientas -->
            <div class="col-12 col-md-6">
                <RadzenCard Variant="Variant.Outlined" Class="h-100 tech-card">
                    <h4 class="mb-3">@AllResourcesResolver["svcs"]</h4>

                    <ul class="mb-3">
                        <li>GIT, GitHub, GitLab</li>
                    </ul>

                    <div class="d-flex flex-wrap gap-3">
                        <a href="https://git-scm.com/" target="_blank">
                            <img class="tech-icon" src="assets/icons/git.png" />
                        </a>

                        <a href="https://github.com/" target="_blank">
                            <img class="tech-icon" src="assets/icons/github.png" />
                        </a>

                        <a href="https://gitlab.com/" target="_blank">
                            <img class="tech-icon" src="assets/icons/gitlab.png" />
                        </a>
                    </div>
                </RadzenCard>
            </div>

            <!-- CI/CD -->
            <div class="col-12 col-md-6">
                <RadzenCard Variant="Variant.Outlined" Class="h-100 tech-card">
                    <h4 class="mb-3">QA, CI / CD</h4>

                    <ul class="mb-3">
                        <li>Jenkins, Docker, SonarQube, Podman</li>
                    </ul>

                    <div class="d-flex flex-wrap gap-3">
                        <a href="https://www.jenkins.io/" target="_blank">
                            <img class="tech-icon" src="assets/icons/jenkins.png" />
                        </a>

                        <a href="https://www.docker.com/" target="_blank">
                            <img class="tech-icon" src="assets/icons/docker.png" />
                        </a>

                        <a href="https://www.sonarsource.com/products/sonarqube/" target="_blank">
                            <img class="tech-icon" src="assets/icons/sonarqube.png" />
                        </a>

                        <a href="https://podman.io/" target="_blank">
                            <img class="tech-icon" src="assets/icons/podman.png" />
                        </a>
                    </div>
                </RadzenCard>
            </div>

            <!-- Metodologías -->
            <div class="col-12">
                <RadzenCard Variant="Variant.Outlined" Class="tech-card">
                    <h4 class="mb-3">
                        @AllResourcesResolver["metodologias"]
                    </h4>

                    <ul class="mb-0">
                        <li>Agile, Scrum</li>
                        <li>DDD & Clean Architecture</li>
                        <li>SOLID</li>
                    </ul>
                </RadzenCard>
            </div>

        </div>
    </div>
</section>

<hr class="m-0" />

<style>
    .tech-card {
        transition: all 0.25s ease;
    }

        .tech-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

    .tech-icon {
        height: 50px;
        object-fit: contain;
        transition: transform 0.2s;
    }

        .tech-icon:hover {
            transform: scale(1.1);
        }
</style>