<section class="resume-section" id="@SectionIds.SobreMi">
    <div class="resume-section-content">

        <PageTitleCentered Title=@(@Common["nav_sobremi"]) />


        <Proyectos />

        <div class="subsection">
            <h3 class="subsection-title">@L["sobremi_personal"]</h3>
            <p>@L["descripcionSobreMi2"]</p>
            <p class="about-closing">@L["descripcionSobreMi3"]</p>
        </div>

        <div class="gallery">
            @foreach (var img in Images)
            {
                <div class="gallery-item" @onclick="() => OpenImage(img)">
                    <img src="@img" />
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(selectedImage))
        {
            <div class="lightbox" @onclick="CloseImage">
                <img src="@selectedImage" />
            </div>
        }

    </div>
</section>
