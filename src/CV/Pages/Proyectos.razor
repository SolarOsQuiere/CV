@using CV.Shared.Resources;
@inject IStringLocalizer<ProjectsRes> L
@inject IStringLocalizer<CommonRes> Common

<section class="resume-section" id="proyectos">
    <div class="resume-section-content">

        <PageTitleCentered Title=@(@Common["nav_proyectos"]) />

        <p class="lead text-center mb-5">@L["proyectosIntro"]</p>

        <div class="project-grid">

            <!-- SolarBlazorDocs (paquete NuGet) -->
            <article class="project-card">
                <header class="project-head">
                    <span class="project-icon"><i class="fas fa-file-pdf"></i></span>
                    <h3>SolarBlazorDocs</h3>
                </header>

                <p class="project-desc">@L["solarBlazorDocsDesc"]</p>

                <ul class="hero-chips project-tags">
                    <li>Blazor</li>
                    <li>.NET 10</li>
                    <li>NuGet</li>
                    <li>PDF</li>
                    <li>Excel</li>
                    <li>WebAssembly</li>
                </ul>

                <ul class="project-pkgs">
                    <li>SolarBlazorDocs.Abstractions</li>
                    <li>SolarBlazorDocs.Pdf · SolarBlazorDocs.Excel</li>
                    <li>SolarBlazorDocs.Browser</li>
                </ul>

                <div class="project-actions">
                    <a class="btn-cv btn-cv-primary" target="_blank" rel="noopener noreferrer"
                       href="https://www.nuget.org/packages?q=SolarBlazorDocs">
                        <i class="fas fa-cube"></i>&nbsp;NuGet
                    </a>
                </div>
            </article>

            <!-- PasswordManager -->
            <article class="project-card">
                <header class="project-head">
                    <span class="project-icon"><i class="fas fa-key"></i></span>
                    <h3>PasswordManager</h3>
                </header>

                <p class="project-desc">@L["passwordManagerDesc"]</p>

                <ul class="hero-chips project-tags">
                    <li>Blazor WebAssembly</li>
                    <li>.NET</li>
                    <li>GitHub Pages</li>
                </ul>

                <div class="project-actions">
                    <a class="btn-cv btn-cv-primary" target="_blank" rel="noopener noreferrer"
                       href="https://solarosquiere.github.io/PasswordManager/">
                        <i class="fas fa-external-link-alt"></i>&nbsp;Demo
                    </a>
                    <a class="btn-cv" target="_blank" rel="noopener noreferrer"
                       href="https://github.com/SolarOsQuiere/PasswordManager">
                        <i class="fab fa-github"></i>&nbsp;GitHub
                    </a>
                </div>
            </article>

        </div>

    </div>
</section>
