<div class="subsection">
    <h3 class="subsection-title">@Common["nav_proyectos"]</h3>
    <p class="subsection-intro">@L["proyectosIntro"]</p>

    <div class="cv-grid">

        <!-- SolarBlazorDocs (paquete NuGet) -->
        <article class="cv-card project-card">
            <header class="cv-card-head">
                <span class="cv-icon project-icon"><i class="fas fa-file-pdf"></i></span>
                <h3>SolarBlazorDocs</h3>
            </header>

            <p class="project-desc">@L["solarBlazorDocsDesc"]</p>

            <ul class="chips project-tags">
                <li>Blazor</li>
                <li>.NET 10</li>
                <li>NuGet</li>
                <li>PDF</li>
                <li>Excel</li>
                <li>WebAssembly</li>
            </ul>

            <ul class="project-pkgs">
                <li>SolarBlazorDocs.Abstractions</li>
                <li>SolarBlazorDocs.Pdf · SolarBlazorDocs.Excel</li>
                <li>SolarBlazorDocs.Browser</li>
            </ul>

            <div class="project-actions">
                <a class="btn-cv btn-cv-primary" target="_blank" rel="noopener noreferrer"
                   href="@ExternalLinks.Projects.SolarBlazorDocsNuGet">
                    <i class="fas fa-cube"></i>&nbsp;NuGet
                </a>
            </div>
        </article>

        <!-- PasswordManager -->
        <article class="cv-card project-card">
            <header class="cv-card-head">
                <span class="cv-icon project-icon"><i class="fas fa-key"></i></span>
                <h3>PasswordManager</h3>
            </header>

            <p class="project-desc">@L["passwordManagerDesc"]</p>

            <ul class="chips project-tags">
                <li>Blazor WebAssembly</li>
                <li>.NET</li>
                <li>GitHub Pages</li>
            </ul>

            <div class="project-actions">
                <a class="btn-cv btn-cv-primary" target="_blank" rel="noopener noreferrer"
                   href="@ExternalLinks.Projects.PasswordManagerDemo">
                    <i class="fas fa-external-link-alt"></i>&nbsp;Demo
                </a>
                <a class="btn-cv" target="_blank" rel="noopener noreferrer"
                   href="@ExternalLinks.Projects.PasswordManagerRepo">
                    <i class="fab fa-github"></i>&nbsp;GitHub
                </a>
            </div>
        </article>

    </div>
</div>
