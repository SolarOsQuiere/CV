@using CV.Shared.Resources;
@inject IStringLocalizer<EducationRes> L
@inject IStringLocalizer<CommonRes> Common

<section class="resume-section" id="educacion">
    <div class="resume-section-content">

        <PageTitleCentered Title=@(@Common["nav_educacion"]) />

        <div class="edu-grid">

            <!-- Universidad -->
            <article class="edu-card edu-featured">
                <img class="edu-logo" src="assets/img/logoUniversidad.png" alt="Universidad de La Rioja" />
                <div class="edu-body">
                    <span class="edu-date">sept. 2017 - jul. 2022</span>
                    <h3>Universidad de La Rioja</h3>
                    <p>@L["descripcionUniversidad"]</p>
                </div>
            </article>

            <!-- Bachiller -->
            <article class="edu-card">
                <img class="edu-logo" src="assets/img/logoInstituto.png" alt="IES Valle del Oja" />
                <div class="edu-body">
                    <span class="edu-date">sept. 2015 - jul. 2017</span>
                    <h3>IES Valle del Oja</h3>
                    <p>@L["descripcionBachiller"]</p>
                </div>
            </article>

            <!-- Conservatorio -->
            <article class="edu-card">
                <img class="edu-logo" src="assets/img/logoConservatorio.png" alt="Conservatorio de Haro" />
                <div class="edu-body">
                    <span class="edu-date">ago. 2012 - may. 2016</span>
                    <h3>Conservatorio de Haro</h3>
                    <p>@L["descripcionConservatorio"]</p>
                </div>
            </article>

            <!-- ESO -->
            <article class="edu-card">
                <img class="edu-logo" src="assets/img/logoInstituto.png" alt="IES Valle del Oja" />
                <div class="edu-body">
                    <span class="edu-date">sept. 2011 - jul. 2015</span>
                    <h3>IES Valle del Oja</h3>
                    <p>@L["descripcionEso"]</p>
                </div>
            </article>

        </div>

    </div>
</section>
