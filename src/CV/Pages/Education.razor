<section class="resume-section" id="@SectionIds.Educacion">
    <div class="resume-section-content">

        <PageTitleCentered Title=@(@Common["nav_educacion"]) />

        <div class="cv-grid">
            @foreach (var e in _estudios)
            {
                <ListItemCard Logo="@e.Logo" LogoAlt="@e.Titulo" Fecha="@e.Fecha" Titulo="@e.Titulo" Featured="@e.Destacado">
                    <p>@e.Descripcion</p>
                </ListItemCard>
            }
        </div>

    </div>
</section>
