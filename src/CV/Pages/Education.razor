@page "/Education"
@page "/Educacion"
@page "/CV/Education"
@page "/CV/Educacion"

@using CV.Shared.Resources;
@inject IStringLocalizer<AllResourcesRes> AllResourcesResolver

<section class="resume-section" id="educacion">
    <div class="resume-section-content">

        <PageTitleCentered Title=@(@AllResourcesResolver["navbar_educacion"]) />

        <!-- Universidad -->
        <SharedSection
            Titulo="Universidad de La Rioja"
            Subtitulo="@AllResourcesResolver["descripcionUniversidad"]"
            TiempoTrabajo="Sep. 2017 - Jul. 2022"
            SrcImagen="assets/img/logoUniversidad.png"
            AltImagen="Universidad de La Rioja">

        </SharedSection>

        <!-- Bachiller -->
        <SharedSection
            Titulo="IES Valle del Oja"
            Subtitulo="@AllResourcesResolver["descripcionBachiller"]"
            TiempoTrabajo="Sep. 2015 - Jul. 2017"
            SrcImagen="assets/img/logoInstituto.png"
            AltImagen="IES Valle del OJA">

        </SharedSection>

        <!-- Conservatorio -->
        <SharedSection
            Titulo="Conservatorio de Haro"
            Subtitulo="@AllResourcesResolver["descripcionConservatorio"]"
            TiempoTrabajo="Aug. 2012 - May 2016"
            SrcImagen="assets/img/logoConservatorio.png"
            AltImagen="Conservatorio de Haro">

        </SharedSection>

        <!-- ESO -->
        <SharedSection
            Titulo="IES Valle del Oja"
            Subtitulo="@AllResourcesResolver["descripcionEso"]"
            TiempoTrabajo="Sep. 2011 - Jul. 2015"
            SrcImagen="assets/img/logoInstituto.png"
            AltImagen="IES Valle del OJA">

        </SharedSection>

    </div>
</section>