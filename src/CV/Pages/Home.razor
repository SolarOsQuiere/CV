@page "/"
@page "/Inicio"
@page "/Index"
@page "/CV"
@page "/AboutMe"
@page "/SobreMi"
@page "/CV/AboutMe"
@page "/CV/SobreMi"
@page "/Experiencia"
@page "/Experience"
@page "/CV/Experiencia"
@page "/CV/Experience"
@page "/Education"
@page "/Educacion"
@page "/CV/Education"
@page "/CV/Educacion"
@page "/Cursos"
@page "/Courses"
@page "/CV/Cursos"
@page "/CV/Courses"
@page "/Tecnologias"
@page "/Technologies"
@page "/CV/Tecnologias"
@page "/CV/Technologies"
@page "/Proyectos"
@page "/Projects"
@page "/CV/Proyectos"
@page "/CV/Projects"

@implements IAsyncDisposable
@using CV.Shared.Services.Menu
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MenuService MenuService

@* Pagina unica: todas las secciones del CV en scroll continuo. Las rutas antiguas
   (/Experiencia, /Projects...) siguen funcionando y hacen scroll a su seccion. *@

<div class="cv-carousel" id="cv-carousel">
    <Inicio ShowActions="true" />
    <SobreMi />
    <Experiencia />
    <Education />
    <Cursos />
    <Tecnologias />
    <Proyectos />
</div>

@if (_indice > 0)
{
    <button type="button" class="carousel-arrow carousel-prev no-print" aria-label="@MenuService.MenuItems[_indice - 1].Text"
            @onclick="() => Mover(-1)"><i class="fas fa-chevron-left"></i></button>
}
@if (_indice < MenuService.MenuItems.Count - 1)
{
    <button type="button" class="carousel-arrow carousel-next no-print" aria-label="@MenuService.MenuItems[_indice + 1].Text"
            @onclick="() => Mover(1)"><i class="fas fa-chevron-right"></i></button>
}

<div class="carousel-dots no-print">
    @foreach (var item in MenuService.MenuItems)
    {
        var destino = item;
        <button type="button" class="@(destino.IsActive ? "active" : "")" aria-label="@destino.Text" title="@destino.Text"
                @onclick="() => Ir(destino)"></button>
    }
</div>

@code {
    private DotNetObjectReference<Home>? _self;

    private int _indice => Math.Max(0, MenuService.MenuItems.FindIndex(i => i.IsActive));

    protected override void OnInitialized() => MenuService.OnChange += Refrescar;

    private void Refrescar() => InvokeAsync(StateHasChanged);

    private async Task Ir(MenuNavLink item)
    {
        MenuService.CambiarPagina(item);
        await JS.InvokeVoidAsync("cvNav.scrollTo", item.Href);
    }

    private Task Mover(int paso)
    {
        var destino = _indice + paso;
        return destino < 0 || destino >= MenuService.MenuItems.Count
            ? Task.CompletedTask
            : Ir(MenuService.MenuItems[destino]);
    }

    private static readonly Dictionary<string, string> Rutas = new(StringComparer.OrdinalIgnoreCase)
    {
        ["sobremi"] = "sobremi", ["aboutme"] = "sobremi",
        ["experiencia"] = "experiencia", ["experience"] = "experiencia",
        ["educacion"] = "educacion", ["education"] = "educacion",
        ["cursos"] = "cursos", ["courses"] = "cursos",
        ["tecnologias"] = "tecnologias", ["technologies"] = "tecnologias",
        ["proyectos"] = "proyectos", ["projects"] = "proyectos"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("cvNav.observe", MenuService.MenuItems.Select(i => i.Href).ToArray(), _self);

        var ruta = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
        var ultimo = ruta[(ruta.LastIndexOf('/') + 1)..];
        if (Rutas.TryGetValue(ultimo, out var id))
        {
            await JS.InvokeVoidAsync("cvNav.scrollTo", id);
        }
    }

    [JSInvokable]
    public void SetActive(string id) => MenuService.CambiarPaginaPorRuta(id);

    /// <summary>Navegacion con las flechas del teclado.</summary>
    [JSInvokable]
    public Task Step(int paso) => Mover(paso);

    public async ValueTask DisposeAsync()
    {
        MenuService.OnChange -= Refrescar;
        try { await JS.InvokeVoidAsync("cvNav.unobserve"); } catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
