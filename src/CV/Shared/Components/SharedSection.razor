@using CV.Shared.Resources;

<RadzenCard Variant="Variant.Outlined" class="mb-custom experience-card">
    <div class="d-flex flex-column flex-md-row justify-content-between mb-5">

        <img class="experience-image" src="@SrcImagen" alt="@AltImagen" />

        <div class="flex-grow-1 content">
            <h3 class="mb-0">@Titulo</h3>
            <div class="subheading mb-3">@Subtitulo</div>

            @Description
        </div>

        <div class="flex-shrink-0 time">
            <span class="text-primary">@TiempoTrabajo</span>
        </div>

    </div>
</RadzenCard>

@code {
    [Parameter] public String SrcImagen { get; set; }
    [Parameter] public String AltImagen { get; set; }
    [Parameter] public RenderFragment Description { get; set; }
    [Parameter] public String TiempoTrabajo { get; set; }
    [Parameter] public String Subtitulo { get; set; }
    [Parameter] public String Titulo { get; set; }
}
<style>

    .mb-custom {
        margin-bottom: 20px;
    }

    .experience-card {
        transition: all 0.25s ease;
    }

        /* Efecto hover */
        .experience-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.15);
        }

    /* Imagen */
    .experience-image {
        width: 200px;
        height: 200px;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    /* Zoom ligero en la imagen */
    .experience-card:hover .experience-image {
        transform: scale(1.05);
    }

    /* Contenido */
    .content {
        margin-left: 20px;
    }

    /* Responsive: mejor alineación */
    @@media (max-width: 768px) {
        .content {
            margin-left: 0;
            margin-top: 15px;
        }
    }

    /* Tiempo (lado derecho) */
    .time {
        font-weight: bold;
        transition: color 0.2s ease;
    }

    .experience-card:hover .time {
        color: #0d6efd;
    }
</style>