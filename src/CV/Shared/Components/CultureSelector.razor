@* Selector de idioma: control segmentado ES | EN. *@
<div class="lang-switch" role="group" aria-label="Language">
    @foreach (var (codigo, etiqueta) in Idiomas)
    {
        var activo = codigo == IdiomaActual;
        <button type="button" class="@(activo ? "active" : "")" aria-pressed="@activo"
                @onclick="() => Cambiar(codigo)">@etiqueta</button>
    }
</div>
