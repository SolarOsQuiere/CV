@* Boton flotante que imprime / guarda como PDF el CV completo usando SolarBlazorDocs.Browser. *@
<button type="button" class="@CssClass" @onclick="ImprimirCv" disabled="@_busy" title="@Label">
    <span class="cv-print-label">@(_busy ? BusyLabel : Label)</span>
</button>


<style>
    .cv-print-fab {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 1080;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 18px;
        border: none;
        border-radius: 999px;
        background: #1086c5;
        color: #fff;
        font-weight: 600;
        font-size: 15px;
        cursor: pointer;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
        transition: transform 0.15s ease, background 0.15s ease;
    }

    .cv-print-fab:hover {
        background: #0b6da0;
        transform: translateY(-2px);
    }

    .cv-print-fab:disabled {
        opacity: 0.7;
        cursor: default;
    }

    @@media print {
        .cv-print-fab { display: none !important; }
    }
</style>
