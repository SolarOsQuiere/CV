@using SolarBlazorDocs.Browser.Services
@inject IBrowserDocumentPrinter Printer
@inject NavigationManager Nav

@* Boton flotante que imprime / guarda como PDF el CV completo usando SolarBlazorDocs.Browser. *@
<button type="button" class="cv-print-fab" @onclick="ImprimirCv" disabled="@_busy" title="Descargar CV en PDF">
    @if (_busy)
    {
        <i class="fas fa-spinner fa-spin"></i>
    }
    else
    {
        <i class="fas fa-file-pdf"></i>
    }
    <span>PDF</span>
</button>

@code {
    private bool _busy;

    private async Task ImprimirCv()
    {
        _busy = true;
        try
        {
            var parametros = new Dictionary<string, object?>
            {
                ["BaseUri"] = Nav.BaseUri,
                ["Language"] = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName
            };

            await Printer.PrintComponentAsync<CV.CvDocument>(parametros);
        }
        finally
        {
            _busy = false;
        }
    }
}

<style>
    .cv-print-fab {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 1080;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 18px;
        border: none;
        border-radius: 999px;
        background: #1086c5;
        color: #fff;
        font-weight: 600;
        font-size: 15px;
        cursor: pointer;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
        transition: transform 0.15s ease, background 0.15s ease;
    }

    .cv-print-fab:hover {
        background: #0b6da0;
        transform: translateY(-2px);
    }

    .cv-print-fab:disabled {
        opacity: 0.7;
        cursor: default;
    }

    @@media print {
        .cv-print-fab { display: none !important; }
    }
</style>
